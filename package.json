{
  "name": "@fanwaave/embedding-contract",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:typespec && npm run check:contract",
    "check:typespec": "tsp compile embedding-contract/embeddings.tsp --emit=@typespec/json-schema --output-dir .typespec-output --option @typespec/json-schema.emitAllModels=true --option @typespec/json-schema.file-type=json --option @typespec/json-schema.seal-object-schemas=true",
    "check:contract": "node scripts/verify-embedding-contract.mjs"
  },
  "devDependencies": {
    "@typespec/compiler": "1.15.0",
    "@typespec/json-schema": "1.15.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
