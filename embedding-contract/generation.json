    { "provider": "openai", "model": "text-embedding-3-large", "minimum": 1, "default": 3072, "maximum": 3072, "mrl": true },
    { "provider": "google", "model": "gemini-embedding-001", "minimum": 128, "default": 3072, "maximum": 3072, "mrl": true },
    { "provider": "qwen", "model": "Qwen/Qwen3-Embedding-8B", "minimum": 32, "default": 4096, "maximum": 4096, "mrl": true },
    { "provider": "nvidia", "model": "nvidia/NV-Embed-v2", "minimum": 4096, "default": 4096, "maximum": 4096, "mrl": false },
    { "provider": "baai", "model": "BAAI/bge-en-icl", "minimum": 4096, "default": 4096, "maximum": 4096, "mrl": false },
    { "provider": "voyage", "model": "voyage-4-large", "minimum": 256, "default": 1024, "maximum": 2048, "mrl": true, "allowed": [256, 512, 1024, 2048] },
